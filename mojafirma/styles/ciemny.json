{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ciemny",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#121212", "name": "Tło" },
				{ "slug": "contrast", "color": "#f2f2f2", "name": "Tekst" },
				{ "slug": "primary", "color": "#7cc4e0", "name": "Kolor marki" },
				{ "slug": "primary-dark", "color": "#a9dcee", "name": "Kolor marki (hover)" },
				{ "slug": "accent", "color": "#ffb27a", "name": "Akcent" },
				{ "slug": "surface", "color": "#1e2a30", "name": "Powierzchnia" },
				{ "slug": "muted", "color": "#b8c2ca", "name": "Tekst pomocniczy" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": { "text": "var(--wp--preset--color--base)" },
				":hover": { "color": { "text": "var(--wp--preset--color--base)" } }
			}
		}
	}
}
